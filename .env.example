# Copy to .env and edit
SITE_NAME=mysite
WEB_ROOT=/srv/mysite
UPLOAD_DIR=/srv/mysite/uploads
LISTEN_PORT=8081
LOG_DIR=/data/nginx/logs
CERT_DIR=/etc/ssl/mycerts
# 1 = Nginx proxies to a backend (sets httpd_can_network_connect)
ENABLE_PROXY=0
# 1 = only DB ports (httpd_can_network_connect_db); 0 = any outbound connection
ALLOW_DB_ONLY=0
OPEN_FIREWALL=1
